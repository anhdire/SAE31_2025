@startuml
title Architecture MVC - Sprint 0 (Papillon - version Base de Données)

' =====================
' ===   PACKAGES   ===
' =====================
package "model" {
    class Rappel {
        - id : int
        - titre : String
        - contenu : String
        - theme : int
        - rang : int

        + Rappel(int, String, String, int, int)
        + getId() : int
        + setId(int)
        + getTitre() : String
        + setTitre(String)
        + getContenu() : String
        + setContenu(String)
        + getTheme() : int
        + setTheme(int)
        + getRang() : int
        + setRang(int)
        + toString() : String
    }

    class DBManager {
        - URL : String
        - USER : String
        - PASSWORD : String
        - connection : Connection

        + DBManager()
        + getConnection() : Connection
        + closeConnection() : void
    }

    class RappelDAO {
        - connection : Connection

        + RappelDAO(Connection)
        + ajouterRappel(Rappel)
        + modifierRappel(Rappel)
        + supprimerRappel(int)
        + getRappel(int) : Rappel
        + getTousLesRappels() : List<Rappel>
    }
}

package "view" {
    class MainFrame {
        - listePanel : ListePanel
        - formPanel : FormPanel
        - detailPanel : DetailPanel
        - cardLayout : CardLayout
        - container : JPanel

        + MainFrame()
        + showPanel(String)
        + getListePanel() : ListePanel
        + getFormPanel() : FormPanel
        + getDetailPanel() : DetailPanel
    }

    class ListePanel {
        - table : JTable
        - boutonAjouter : JButton
        - boutonModifier : JButton
        - boutonSupprimer : JButton

        + rafraichirListe(List<Rappel>)
        + getBoutonAjouter() : JButton
        + getBoutonModifier() : JButton
        + getBoutonSupprimer() : JButton
    }

    class FormPanel {
        - champTitre : JTextField
        - champContenu : JTextArea
        - champTheme : JComboBox
        - champRang : JTextField
        - boutonSauvegarder : JButton
        - boutonAnnuler : JButton

        + getRappelFromForm() : Rappel
        + remplirChamps(Rappel)
        + viderChamps()
    }

    class DetailPanel {
        - labelTitre : JLabel
        - labelContenu : JTextArea
        - labelTheme : JLabel
        - labelRang : JLabel

        + afficherRappel(Rappel)
    }
}

package "controller" {
    class RappelController {
        - dao : RappelDAO
        - vue : MainFrame

        + RappelController(RappelDAO, MainFrame)
        + afficherListe()
        + afficherForm(Rappel)
        + afficherDetail(Rappel)
        + ajouterRappel(Rappel)
        + modifierRappel(Rappel)
        + supprimerRappel(int)
        + chargerTousLesRappels()
    }
}

package "listeners" {
    class AjouterRappelListener {
        + actionPerformed(ActionEvent)
    }

    class ModifierRappelListener {
        + actionPerformed(ActionEvent)
    }

    class SupprimerRappelListener {
        + actionPerformed(ActionEvent)
    }

    class SauvegarderRappelListener {
        + actionPerformed(ActionEvent)
    }

    class RetourListeListener {
        + actionPerformed(ActionEvent)
    }
}

package "root" {
    class App {
        + main(String[])
    }
}

' =====================
' === RELATIONS ===
' =====================

App --> RappelController
App --> MainFrame
App --> RappelDAO
RappelDAO --> DBManager
RappelController --> RappelDAO
RappelController --> MainFrame
MainFrame --> ListePanel
MainFrame --> FormPanel
MainFrame --> DetailPanel
ListePanel --> Rappel
FormPanel --> Rappel
DetailPanel --> Rappel

AjouterRappelListener --> RappelController
ModifierRappelListener --> RappelController
SupprimerRappelListener --> RappelController
SauvegarderRappelListener --> RappelController
RetourListeListener --> RappelController

@enduml
